{
  "name": "@appartmint/util",
  "author": "App/Art Mint",
  "version": "2.0.1",
  "license": "MIT",
  "description": "App/Art Mint Utility Functions",
  "keywords": [
    "appartmint",
    "app-art-mint",
    "functions",
    "mixins",
    "utility",
    "variables"
  ],
  "homepage": "https://github.com/App-Art-Mint/npm-util#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/App-Art-Mint/npm-util.git"
  },
  "bugs": {
    "url": "https://github.com/App-Art-Mint/npm-util/issues"
  },
  "main": "dist/js/index.min.js",
  "types": "dist/js/index.d.ts",
  "type": "module",
  "files": [
    "src/scss/**/*.scss",
    "dist/**/*.{css,js,d.ts,map}"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "preversion": "npm i && npm run test",
    "version": "git add -A",
    "postversion": "git push && git push --tags && gh release create v$npm_package_version --generate-notes",
    "prepare": "npm-run-all clean bundle",
    "clean": "rimraf dist doc",
    "clear": "npm run clean",
    "bundle": "npm-run-all build build:**",
    "build": "webpack --config src/config/webpack.config.js",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "build:tsdoc": "typedoc",
    "watch": "npm run build -- --watch",
    "watch:prod": "cross-env NODE_ENV=production npm run watch",
    "watch:tsdoc": "npm run build:tsdoc -- --watch",
    "test": "echo-cli \"\\nRun tests here!\\n\""
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "echo-cli": "^2.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sass": "^1.83.1",
    "sass-loader": "^16.0.4",
    "ts-loader": "^9.5.1",
    "typedoc": "^0.27.6",
    "typescript": "^5.5.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
